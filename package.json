{
  "name": "labeler",
  "version": "6.0.0",
  "description": "Easily manage default labels in GitHub repositories.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Sebastião Barros (@Zebiano)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zebiano/Labeler.git"
  },
  "homepage": "https://github.com/zebiano/Labeler#readme",
  "bugs": {
    "url": "https://github.com/zebiano/Labeler/issues"
  },
  "keywords": [
    "cli",
    "meow",
    "labels",
    "GitHub",
    "labeler"
  ],
  "scripts": {
    "clean": "rm -rf dist .tsbuildinfo",
    "build": "tsc && chmod +x dist/labeler.js",
    "dev": "tsc --watch",
    "start": "tsc && node dist/labeler.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "npm run clean && npm run build",
    "test": "node --experimental-test-module-mocks --import ./dist/test/helpers/sandbox.js --experimental-test-coverage --test-coverage-exclude='dist/**/*.test.js' --test-coverage-exclude='dist/test/**' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test dist/lib/*.test.js",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "bin": {
    "labeler": "dist/labeler.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.js",
    "!dist/test"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "conf": "^15.1.0",
    "inquirer": "^14.2.2",
    "meow": "^14.1.0",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
